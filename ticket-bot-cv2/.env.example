# Required. Create a fresh token in the Discord Developer Portal.
DISCORD_TOKEN=

# Optional hosted AI provider key. This project defaults to Groq.
AI_API_KEY=

# Bot behavior
BOT_PREFIX=!
BOT_STATUS=!help | /help
BOT_STATUS_TYPE=WATCHING
SUPPORT_SERVER_URL=
STREAM_URL=

# Attribution and ticket defaults shown by the bot
DEFAULT_PANEL_FOOTER=Developed by Nystic Shadow
TICKET_BANNER_URL=
TICKET_RULES_TEXT=Describe the issue clearly, include relevant evidence, and avoid duplicate tickets.

# Hardcoded assistance panel (Border State Roleplay). The bot has no setup
# commands: these IDs wire it to the one server it serves.
ASSISTANCE_GUILD_ID=
ASSISTANCE_PANEL_CHANNEL_ID=
ASSISTANCE_TICKET_CATEGORY_ID=
ASSISTANCE_SUPPORT_ROLE_ID=
ASSISTANCE_LOG_CHANNEL_ID=

# Banner artwork: top banner and the "WHERE THE FUN STARTS" bar, for the panel
# and for the "New Ticket Opened" message inside a ticket.
ASSISTANCE_PANEL_BANNER_URL=
ASSISTANCE_PANEL_FOOTER_URL=
ASSISTANCE_TICKET_BANNER_URL=
ASSISTANCE_TICKET_FOOTER_URL=

# Runtime paths and logging
DATABASE_PATH=bot.db
TRIGGERS_DATABASE_PATH=triggers.db
LOG_PATH=bot.log
LOG_LEVEL=INFO

# Upload the purple emoji pack into every server the bot is in
AUTO_SYNC_GUILD_EMOJIS=true
EMOJI_DIRECTORY=emojis
